[Unit]
Description=Matrix R2 management command poller
After=network-online.target matrix-control.service
Requires=matrix-control.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/matrix/deploy/control/bin/matrix-mailbox --config /opt/matrix/deploy/control/local.json
TimeoutStartSec=5min
# A kill in the dispatch window leaves UNKNOWN, never an automatic replay.
TimeoutStopSec=30s
Nice=10
Environment=GOMAXPROCS=1
