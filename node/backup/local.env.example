# Optional HOST settings. The Agent writes this after inspecting the new host.
# Keep it local, chmod 600. S3 credentials remain in the user's s3.env.
LOCAL_CONFIG_SCHEMA=1
RESTORE_ROOT='/opt/matrix'
WORK_ROOT='/opt/matrix/generations'
LOCK_FILE='/opt/matrix/agent/recovery.lock'
DOCKER_BIN='docker'
# Leave empty for `docker compose`, or specify a standalone Compose executable.
COMPOSE_BIN=''
SQLITE_BIN='sqlite3'
NGINX_BIN='nginx'
NGINX_MAIN_CONF='/etc/nginx/nginx.conf'
# MUST be included inside http{} in the above nginx configuration.
NGINX_HTTP_CONF_DIR='/etc/nginx/conf.d'
NGINX_SERVICE='nginx'
SYSTEMCTL_BIN='systemctl'
SYSTEMD_UNIT_DIR='/etc/systemd/system'
