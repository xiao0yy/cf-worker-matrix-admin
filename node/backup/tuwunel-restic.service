[Unit]
Description=Online Tuwunel checkpoint to restic S3 repository
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/opt/matrix/deploy/backup/restic.env

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/matrix/deploy/backup/tuwunel-restic.sh run
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
TimeoutStartSec=infinity
