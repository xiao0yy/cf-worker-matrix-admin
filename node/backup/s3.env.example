S3_REGION='auto'
S3_BUCKET='REPLACE_CONTROL_BUCKET'
CLUSTER_ID='REPLACE_CLUSTER_ID'
AWS_ACCESS_KEY_ID='REPLACE_R2_ACCESS_KEY_ID'
AWS_SECRET_ACCESS_KEY='REPLACE_R2_SECRET_ACCESS_KEY'
# No B2 credentials or RESTIC_PASSWORD in this file.
